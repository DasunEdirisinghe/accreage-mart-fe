# Copy to .env.local and fill in. .env*.local is gitignored.

# Frappe backend base URL (used by server code and, as a public var, the browser).
NEXT_PUBLIC_FRAPPE_URL=http://accreage-mart.localhost:8000

# iron-session cookie encryption secret. Must be 32+ characters.
# Generate one with:  openssl rand -base64 32
SECRET_COOKIE_PASSWORD=replace-with-a-long-random-string-at-least-32-chars

# Show the one-click demo role sign-in cards on /login.
# Leave unset (or "false") in any deployed environment.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true
